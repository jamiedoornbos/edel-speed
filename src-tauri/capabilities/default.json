{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:read-files",
    "http:default",
    "http:allow-fetch-send",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://cloud.lightspeedapp.com/**" },
        { "url": "https://api.lightspeedapp.com/**" }
      ]
    }
  ]
}
